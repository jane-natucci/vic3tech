# Generated from Paradox's game files by extract.rb -- deployed to the site,
# never committed. Only our own files in vic3/ are tracked.
/vic3/*
!/vic3/favicon.svg
!/vic3/og-image.jpg
!/vic3/save-worker.js
.DS_Store
# The Steam guide's text is tracked; its screenshots show Paradox's game art.
/steam-guide/*
!/steam-guide/guide.txt
